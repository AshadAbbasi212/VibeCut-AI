{
  "$defs": {
    "AnimationConfig": {
      "properties": {
        "in": {
          "anyOf": [
            {
              "enum": [
                "pop",
                "slide_up",
                "fade",
                "typewriter",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "pop",
          "title": "In"
        },
        "out": {
          "anyOf": [
            {
              "enum": [
                "fade",
                "pop",
                "none"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "fade",
          "title": "Out"
        },
        "wordStagger": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 0.04,
          "title": "Wordstagger"
        }
      },
      "title": "AnimationConfig",
      "type": "object"
    },
    "CameraCut": {
      "properties": {
        "start": {
          "description": "Cut start time in seconds",
          "title": "Start",
          "type": "number"
        },
        "end": {
          "description": "Cut end time in seconds",
          "title": "End",
          "type": "number"
        },
        "focusX": {
          "default": 0.5,
          "description": "Horizontal center focus (0.0 to 1.0)",
          "title": "Focusx",
          "type": "number"
        },
        "speakerId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "speaker_0",
          "description": "Identifier of the active speaker",
          "title": "Speakerid"
        },
        "layout": {
          "anyOf": [
            {
              "enum": [
                "solo",
                "split_duo",
                "split_trio",
                "wide"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "solo",
          "description": "Layout mode for this cut segment",
          "title": "Layout"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "CameraCut",
      "type": "object"
    },
    "Graphic": {
      "properties": {
        "kind": {
          "description": "Type of graphic: emoji, icon, image, or sticker3d",
          "enum": [
            "emoji",
            "icon",
            "image",
            "sticker3d"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "description": "Emoji char, 3D sticker identifier, Lucide icon name, or image path",
          "title": "Value",
          "type": "string"
        },
        "position": {
          "anyOf": [
            {
              "enum": [
                "above",
                "below",
                "left",
                "right"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "above",
          "description": "Placement relative to text",
          "title": "Position"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "Graphic",
      "type": "object"
    },
    "Highlight": {
      "properties": {
        "wordIndex": {
          "description": "Index of word to highlight",
          "title": "Wordindex",
          "type": "integer"
        },
        "kind": {
          "default": "color",
          "description": "Highlight treatment",
          "enum": [
            "color",
            "italic",
            "pill",
            "underline",
            "scale"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "description": "Color code or token",
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "wordIndex",
        "value"
      ],
      "title": "Highlight",
      "type": "object"
    },
    "TimelineEvent": {
      "properties": {
        "id": {
          "description": "Unique event id e.g. e1",
          "title": "Id",
          "type": "string"
        },
        "style": {
          "description": "Style identifier from docs/04",
          "title": "Style",
          "type": "string"
        },
        "start": {
          "description": "Event start in seconds",
          "title": "Start",
          "type": "number"
        },
        "end": {
          "description": "Event end in seconds",
          "title": "End",
          "type": "number"
        },
        "zone": {
          "default": "lower",
          "enum": [
            "upper",
            "center",
            "lower",
            "free"
          ],
          "title": "Zone",
          "type": "string"
        },
        "x": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fractional x (0-1) for free zone",
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Fractional y (0-1) for free zone",
          "title": "Y"
        },
        "layer": {
          "default": 1,
          "description": "Z-order layer (higher on top)",
          "title": "Layer",
          "type": "integer"
        },
        "wordRange": {
          "description": "[firstIndex, lastIndex] inclusive",
          "items": {
            "type": "integer"
          },
          "title": "Wordrange",
          "type": "array"
        },
        "text": {
          "description": "Spoken text in this event",
          "title": "Text",
          "type": "string"
        },
        "lines": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Pre-split lines for multi-line layout",
          "title": "Lines"
        },
        "highlights": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/Highlight"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Highlights"
        },
        "palette": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "sunset",
          "title": "Palette"
        },
        "decorations": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decorations"
        },
        "graphic": {
          "anyOf": [
            {
              "$ref": "#/$defs/Graphic"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "animation": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnimationConfig"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "variant": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional style variant e.g. 'glow' or 'frosted'",
          "title": "Variant"
        },
        "captionSize": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional caption size override (small, medium, large, or custom px)",
          "title": "Captionsize"
        },
        "backgroundStyle": {
          "anyOf": [
            {
              "enum": [
                "transparent",
                "glass",
                "solid"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Caption background style: transparent, glass, solid",
          "title": "Backgroundstyle"
        },
        "highlightColor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Word highlight hex color",
          "title": "Highlightcolor"
        },
        "sentenceId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Grouping identifier for sentence-level style consistency",
          "title": "Sentenceid"
        }
      },
      "required": [
        "id",
        "style",
        "start",
        "end",
        "text"
      ],
      "title": "TimelineEvent",
      "type": "object"
    },
    "TimelineVideo": {
      "properties": {
        "src": {
          "description": "Path or relative URL to the video source",
          "title": "Src",
          "type": "string"
        },
        "width": {
          "default": 1080,
          "description": "Video width in pixels",
          "title": "Width",
          "type": "integer"
        },
        "height": {
          "default": 1920,
          "description": "Video height in pixels",
          "title": "Height",
          "type": "integer"
        },
        "fps": {
          "default": 30.0,
          "description": "Frames per second",
          "title": "Fps",
          "type": "number"
        },
        "durationSec": {
          "description": "Total duration in seconds",
          "title": "Durationsec",
          "type": "number"
        },
        "layout": {
          "anyOf": [
            {
              "enum": [
                "split_podcast",
                "split_triple",
                "blur_fit",
                "fill",
                "focus_left",
                "focus_right",
                "active_speaker"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": "split_podcast",
          "description": "Video framing layout for landscape to vertical conversion",
          "title": "Layout"
        },
        "originalWidth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Original source video width",
          "title": "Originalwidth"
        },
        "originalHeight": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Original source video height",
          "title": "Originalheight"
        }
      },
      "required": [
        "src",
        "durationSec"
      ],
      "title": "TimelineVideo",
      "type": "object"
    },
    "TimelineWord": {
      "properties": {
        "i": {
          "description": "Global word index",
          "title": "I",
          "type": "integer"
        },
        "text": {
          "description": "Word text",
          "title": "Text",
          "type": "string"
        },
        "start": {
          "description": "Word start time in seconds",
          "title": "Start",
          "type": "number"
        },
        "end": {
          "description": "Word end time in seconds",
          "title": "End",
          "type": "number"
        }
      },
      "required": [
        "i",
        "text",
        "start",
        "end"
      ],
      "title": "TimelineWord",
      "type": "object"
    }
  },
  "properties": {
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    },
    "video": {
      "$ref": "#/$defs/TimelineVideo"
    },
    "language": {
      "default": "en",
      "title": "Language",
      "type": "string"
    },
    "words": {
      "items": {
        "$ref": "#/$defs/TimelineWord"
      },
      "title": "Words",
      "type": "array"
    },
    "events": {
      "items": {
        "$ref": "#/$defs/TimelineEvent"
      },
      "title": "Events",
      "type": "array"
    },
    "captionSize": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "medium",
      "description": "Global caption size (small, medium, large, or custom px)",
      "title": "Captionsize"
    },
    "backgroundStyle": {
      "anyOf": [
        {
          "enum": [
            "transparent",
            "glass",
            "solid"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "transparent",
      "description": "Global background style",
      "title": "Backgroundstyle"
    },
    "highlightColor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "#38BDF8",
      "description": "Global highlight color",
      "title": "Highlightcolor"
    },
    "subtitleY": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Global custom Y position (0.0 to 1.0) dragged by user",
      "title": "Subtitley"
    },
    "videoLayout": {
      "anyOf": [
        {
          "enum": [
            "split_podcast",
            "split_triple",
            "blur_fit",
            "fill",
            "focus_left",
            "focus_right",
            "active_speaker"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "split_podcast",
      "description": "Video framing layout for landscape to vertical conversion",
      "title": "Videolayout"
    },
    "cameraCuts": {
      "anyOf": [
        {
          "items": {
            "$ref": "#/$defs/CameraCut"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Dynamic camera cut timeline for active speaker tracking",
      "title": "Cameracuts"
    },
    "progressBar": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": true,
      "description": "Enable animated retention progress bar",
      "title": "Progressbar"
    },
    "progressBarPosition": {
      "anyOf": [
        {
          "enum": [
            "bottom",
            "top"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "bottom",
      "description": "Position of the retention progress bar",
      "title": "Progressbarposition"
    },
    "headlineHook": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Optional top hook headline card text",
      "title": "Headlinehook"
    },
    "headlineStyle": {
      "anyOf": [
        {
          "enum": [
            "badge",
            "glass",
            "clean",
            "cyber"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "badge",
      "description": "Visual treatment for top hook headline card",
      "title": "Headlinestyle"
    },
    "autoEmojis": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": true,
      "description": "Enable keyword-driven auto-emojis and animated stickers",
      "title": "Autoemojis"
    }
  },
  "required": [
    "video"
  ],
  "title": "Timeline",
  "type": "object"
}